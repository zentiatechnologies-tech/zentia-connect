# Every page is built as a real HTML file (index.html, about/index.html,
# resources/index.html), so no rewrite-to-index is needed any more.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Always use https
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]
</IfModule>

# Unknown addresses get the "page not found" page with a proper 404 status
ErrorDocument 404 /404.html
